# 录音参数。设备留空时使用 Windows 默认输入设备。
RECORDING_DEVICE=
SAMPLE_RATE=16000
CHANNELS=1
SEGMENT_SECONDS=3600
SILENCE_THRESHOLD_DBFS=-48
MIN_ACTIVE_SECONDS=3

# 百炼异步文件转写。请将百炼 API Key 放入 dashscopekey.txt，或在此填写。
STT_PROVIDER=dashscope_filetrans
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-filetrans
DASHSCOPE_DELETE_UPLOADED_FILE=true

# 文本分析：默认 DeepSeek-V4-Flash，失败时依序尝试 DeepSeek-V4-Pro 和千问。
DEFAULT_SUMMARY_MODE=deepseek_v4_flash
BAILIAN_SUMMARY_MODEL=qwen-plus
LLM_MODEL=deepseek-v4-flash

# 阿里云语音分析：仅保存百炼明确返回的说话人、声音事件、语种和性别字段。
DASHSCOPE_ENABLE_DIARIZATION=true
DASHSCOPE_ENABLE_AUDIO_EVENTS=true

# DeepSeek 每日汇总。API Key 可放入 deepseekkey.txt，或在此填写。
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
