# 录音参数。设为 auto 时优先使用可用的 Windows 默认输入设备，否则选择声音最大的输入设备。
RECORDING_DEVICE=auto
SAMPLE_RATE=16000
CHANNELS=1
SEGMENT_SECONDS=3600
SILENCE_THRESHOLD_DBFS=-48
MIN_ACTIVE_SECONDS=3
# Leave blank to save under data/recordings, or set an absolute folder such as D:\\Recordings.
RECORDINGS_DIR=

# 百炼异步文件转写。请将百炼 API Key 放入 dashscopekey.txt，或在此填写。
STT_PROVIDER=dashscope_filetrans
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-filetrans
DASHSCOPE_DELETE_UPLOADED_FILE=true

# 文本分析：默认 DeepSeek-V4-Flash，失败时依序尝试 DeepSeek-V4-Pro 和千问。
DEFAULT_SUMMARY_MODE=deepseek_v4_flash
# Rating templates: general, author_gossip, meeting, risk, or a user_* ID created in the dashboard.
RATING_TEMPLATE=general
# Legacy single-template field. New personal templates are stored in data/rating_templates.json.
RATING_CUSTOM_PROMPT=
BAILIAN_SUMMARY_MODEL=qwen-plus
LLM_MODEL=deepseek-v4-flash

# 阿里云语音分析：仅保存百炼明确返回的说话人、声音事件、语种和性别字段。
DASHSCOPE_ENABLE_DIARIZATION=true
DASHSCOPE_ENABLE_AUDIO_EVENTS=true

# DeepSeek 每日汇总。API Key 可放入 deepseekkey.txt，或在此填写。
# 模型列表每 12 小时从 DeepSeek /models 自动同步，模型改名不需要改这里。
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-flash
DEFAULT_SUMMARY_MODE=deepseek_flash

# 看板访问密码。首次打开看板时也可以设置。
DASHBOARD_PASSWORD=
# Set to 0.0.0.0 to allow devices on the same LAN to access the dashboard; restart the service after changing it.
DASHBOARD_BIND_ADDRESS=127.0.0.1
# Only applies when DASHBOARD_BIND_ADDRESS is 127.0.0.1. LAN access always requires a password.
DASHBOARD_LOCAL_NO_PASSWORD=false
DISK_WARNING_GB=10
# 没有逐字稿的录音（静音、转写失败）保留天数，到期后每天自动删除。0 表示不自动删除。
EMPTY_RETENTION_DAYS=30

# 定时日报。QQ 邮箱 SMTP 使用授权码，不是 QQ 登录密码。
REPORT_ENABLED=false
REPORT_TIMES=12:10,17:10,21:10
REPORT_CHANNELS=smtp
REPORT_EMAIL_RECIPIENT=
REPORT_SMTP_HOST=smtp.qq.com
REPORT_SMTP_PORT=465
REPORT_SMTP_USERNAME=
REPORT_SMTP_AUTH_CODE=

# Optional WeCom robot or PushPlus WeChat delivery.
REPORT_WECOM_WEBHOOK=
REPORT_PUSHPLUS_TOKEN=

# 飞书自建应用机器人。将机器人加入唯一命名的通知群后，REPORT_CHANNELS 可设为 feishu 或与其他渠道组合。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_NAME=
# 可选：同步录音档案至多维表格，并在日报卡片中提供入口。
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# QQ mail query: send an email from the same QQ account to itself. Any text returns the current report;
# include a date such as 2026-08-12 in the subject or body to receive that historical report.
REPORT_QUERY_ENABLED=true
REPORT_IMAP_HOST=imap.qq.com
REPORT_IMAP_PORT=993
REPORT_QUERY_INTERVAL_SECONDS=60

# 自动时段汇总：每天 12:00、17:00、21:00，周日 21:00 另生成本周汇总。
SUMMARY_SCHEDULER_INTERVAL_SECONDS=60
SUMMARY_LOOKBACK_DAYS=7
SUMMARY_FINALIZE_DELAY_SECONDS=30
